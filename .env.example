# ── App ─────────────────────────────────────────────────────────────
# Public origin, used to build the CAS service URL behind proxies.
APP_URL=http://localhost:3000
# 32+ random chars; required in production. `openssl rand -base64 48`
SESSION_SECRET=

# ── SDU integration ────────────────────────────────────────────────
# mock = in-process fake SDU backend (no network); live = real SDU services.
SDU_API_MODE=mock
SDU_CURRENT_TERM=2026-FALL

# Live mode only — values come from SDU IT when the integration is approved.
SDU_API_BASE_URL=
SDU_CAS_BASE_URL=
SDU_OAUTH_TOKEN_URL=
SDU_CLIENT_ID=
SDU_CLIENT_SECRET=
SDU_API_TIMEOUT_MS=8000

# Mock mode tuning
SDU_MOCK_LATENCY_MS=150
# Randomly shift seat counts every ~8s to simulate other students registering.
SDU_MOCK_SEAT_DRIFT=true

# ── Database (PostgreSQL) ──────────────────────────────────────────
# Needed for `db:*` scripts; the dashboard itself runs without it in mock mode.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sdu_registration
